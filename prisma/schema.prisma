generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  // 连接URL已移至prisma.config.ts，此处不再需要url属性
}

model Interview {
  id                   String     @id @default(uuid())
  resumeText           String
  status               String
  extractedTechSkills String     @default("[]")
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt
  questions            Question[]
}

model Question {
  id                 String    @id @default(uuid())
  interviewId        String
  interview          Interview @relation(fields: [interviewId], references: [id])
  questionText       String
  techSkills         String    @default("[]")
  answerText         String?
  technicalScore     Int?
  communicationScore  Int?
  experienceScore    Int?
  techSkillScores    String    @default("{}")
  feedback           String?
  followUpCount      Int       @default(0)
  isCompleted        Boolean   @default(false)
  createdAt          DateTime  @default(now())
}
